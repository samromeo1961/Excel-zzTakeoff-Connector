{
  "name": "excel-zztakeoff-connector",
  "version": "1.0.0",
  "description": "Excel-zzTakeoff Connector - Vue.js + AG Grid + SheetJS Electron Edition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\" --names \"VITE,ELECTRON\" --prefix-colors \"cyan,magenta\"",
    "dev:electron": "wait-on http://localhost:5185 && electron . --dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:chrome": "start \"\" \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --remote-debugging-port=9222 --user-data-dir=\"%TEMP%\\chrome-debug\" --new-window http://localhost:5185 && timeout /t 2 /nobreak >nul && npm run dev:electron",
    "launch-chrome": "start \"\" \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --remote-debugging-port=9222 --user-data-dir=\"%TEMP%\\chrome-debug\" --new-window http://localhost:5185",
    "build-frontend": "cd frontend && npm run build",
    "build": "npm run build-frontend && electron-builder build --win --publish never",
    "dist": "npm run build-frontend && electron-builder --win"
  },
  "keywords": [
    "electron",
    "excel",
    "spreadsheet",
    "zztakeoff",
    "construction",
    "estimating"
  ],
  "author": "Excel-zzTakeoff Connector",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.2.0",
    "sql.js": "^1.13.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.excelzztakeoff.connector",
    "productName": "XLx Connector",
    "copyright": "Copyright © 2025 XLx Connector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "frontend/dist/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Excel-zzTakeoff Connector"
    }
  }
}
